{
  "name": "worktree-launcher",
  "private": true,
  "type": "module",
  "bin": {
    "herdr-worktree-launcher": "dist/herdr-worktree-launcher"
  },
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "install:mod": "node scripts/install-mod.mjs",
